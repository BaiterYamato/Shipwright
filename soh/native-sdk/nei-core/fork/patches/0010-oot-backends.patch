+extern "C" void NeiWorld_OnActorInit(void* actor, void* play) {
+    Actor* self = (Actor*)actor;
+    if (!self || !play) return;
+    switch (self->id) {
+        case ACTOR_BG_SPOT06_OBJECTS: SeasonScene_OnInitLakeHylia(self); break;
+        case ACTOR_BG_MIZU_WATER: SeasonScene_OnInitWaterTemple(self); break;
+        case ACTOR_BG_ICE_SHELTER: case ACTOR_BG_ICE_TURARA: case ACTOR_OBJECT_KANKYO:
+            SeasonScene_ApplyActorRule(self); break;
+        case ACTOR_OBJ_MAKEKINSUTA: SeasonScene_OnInitSoftSoil(self); break;
+        case ACTOR_OBJ_BEAN: SeasonScene_OnInitBeanSpot(self); break;
+        case ACTOR_EN_WEATHER_TAG: SeasonScene_OnInitWeatherTag(self); break;
+        case ACTOR_BG_SPOT01_IDOMIZU: case ACTOR_BG_MORI_IDOMIZU: case ACTOR_BG_HAKA_WATER:
+            SeasonScene_OnInitWaterActor(self); break;
+    }
+}
+extern "C" void NeiWorld_Draw(void* play) {
+    if (play && ((PlayState*)play)->colCtx.colHeader) SeasonScene_DrawGround();
+}
+extern "C" void NeiWorld_Reset(void) {
+    SeasonScene_RestoreWaterBoxes();
+    SeasonScene_SetWaterLook(SEASON_LOOK_VANILLA);
+    sGroundHeader = NULL; sGroundVtx.clear();
+    for (auto& dl : sGroundDl) dl.clear();
+    sSeasonVoidDamage = false;
+}
