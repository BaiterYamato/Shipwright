{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unbound/scene.schema.json",
  "title": "Unbound 2 scene document",
  "description": "A layer for scenes/<scene>/scene.json; completeness is checked after layer merge.",
  "type": "object",
  "properties": {
    "$schema": { "const": "unbound/scene/1", "description": "Optional layer schema marker; one merged layer must provide it." },
    "$replace": { "type": "boolean", "description": "Replace the lower-layer root object." },
    "collision": { "$ref": "common.schema.json#/$defs/path", "description": "Collision document path." },
    "rooms": { "$ref": "common.schema.json#/$defs/positionalList", "description": "Room document paths by room number.", "additionalProperties": { "$ref": "common.schema.json#/$defs/path" } },
    "setups": { "$ref": "common.schema.json#/$defs/positionalList", "description": "Scene setups by numeric setup index.", "additionalProperties": { "$ref": "#/$defs/setup" } }
  },
  "additionalProperties": true,
  "$defs": {
    "setup": {
      "type": "object",
      "description": "Complete scene setup after merge; omitted commands retain engine defaults.",
      "properties": {
        "$replace": { "type": "boolean", "description": "Replace this lower-layer setup." },
        "specialObjects": { "type": "object", "description": "Navi and global object ids.", "properties": { "elfMessage": { "$ref": "common.schema.json#/$defs/integer", "description": "Navi hint id." }, "globalObject": { "$ref": "common.schema.json#/$defs/integer", "description": "Global object id." } }, "additionalProperties": true },
        "skybox": { "type": "object", "description": "Vanilla skybox settings.", "properties": { "id": { "$ref": "common.schema.json#/$defs/integer", "description": "Skybox id." }, "weather": { "$ref": "common.schema.json#/$defs/integer", "description": "Weather id." }, "indoors": { "$ref": "common.schema.json#/$defs/integer", "description": "Indoor flag." }, "unk": { "$ref": "common.schema.json#/$defs/integer", "description": "Vanilla unknown value." } }, "additionalProperties": true },
        "sound": { "type": "object", "description": "Scene music settings.", "properties": { "seq": { "$ref": "common.schema.json#/$defs/integer", "description": "Vanilla sequence id." }, "natureAmbience": { "$ref": "common.schema.json#/$defs/integer", "description": "Nature ambience id." }, "reverb": { "$ref": "common.schema.json#/$defs/integer", "description": "Reverb id." }, "song": { "type": ["string", "null"], "description": "Optional custom sequence path." } }, "additionalProperties": true },
        "cameraSettings": { "type": "object", "description": "Camera and world-map settings.", "properties": { "cameraMovement": { "$ref": "common.schema.json#/$defs/integer", "description": "Camera movement id." }, "worldMapArea": { "$ref": "common.schema.json#/$defs/integer", "description": "World-map area id." } }, "additionalProperties": true },
        "cutscene": { "$ref": "common.schema.json#/$defs/path", "description": "Cutscene resource path." },
        "paths": { "type": "array", "description": "Path document paths in concatenation order.", "items": { "$ref": "common.schema.json#/$defs/path" } },
        "lighting": { "$ref": "common.schema.json#/$defs/positionalList", "description": "Lighting entries.", "additionalProperties": { "$ref": "#/$defs/lighting" } },
        "entrances": { "$ref": "common.schema.json#/$defs/positionalList", "description": "Spawn-to-room entrance entries.", "additionalProperties": { "$ref": "#/$defs/entrance" } },
        "spawns": { "$ref": "common.schema.json#/$defs/positionalList", "description": "Player spawn entries.", "additionalProperties": { "$ref": "#/$defs/spawn" } },
        "exits": { "$ref": "common.schema.json#/$defs/positionalList", "description": "Exit values referenced by collision surfaces.", "additionalProperties": { "$ref": "#/$defs/exit" } },
        "transitionActors": { "$ref": "common.schema.json#/$defs/positionalList", "description": "Cross-room actor entries.", "additionalProperties": { "$ref": "#/$defs/transitionActor" } },
        "materialAnims": { "$ref": "common.schema.json#/$defs/positionalList", "description": "Runtime material animation entries.", "additionalProperties": { "$ref": "#/$defs/materialAnim" } }
      },
      "additionalProperties": true
    },
    "lighting": { "type": "object", "description": "A scene lighting entry.", "properties": { "ambient": { "$ref": "common.schema.json#/$defs/rgb", "description": "Ambient RGB." }, "light1Color": { "$ref": "common.schema.json#/$defs/rgb", "description": "First light RGB." }, "light2Color": { "$ref": "common.schema.json#/$defs/rgb", "description": "Second light RGB." }, "fogColor": { "$ref": "common.schema.json#/$defs/rgb", "description": "Fog RGB." }, "light1Dir": { "$ref": "common.schema.json#/$defs/integerVector", "description": "First light direction." }, "light2Dir": { "$ref": "common.schema.json#/$defs/integerVector", "description": "Second light direction." }, "fogNear": { "$ref": "common.schema.json#/$defs/integer", "description": "Vanilla fog near value." }, "fogBlendRate": { "$ref": "common.schema.json#/$defs/integer", "description": "Vanilla fog blend bits." }, "fogFar": { "$ref": "common.schema.json#/$defs/integer", "description": "Vanilla fog far value." }, "fogStart": { "$ref": "common.schema.json#/$defs/number", "description": "World fog clear distance." }, "fogEnd": { "$ref": "common.schema.json#/$defs/number", "description": "World fog dense distance." }, "drawDistance": { "$ref": "common.schema.json#/$defs/number", "description": "World draw distance." }, "nearPlane": { "$ref": "common.schema.json#/$defs/number", "description": "World near plane." } }, "additionalProperties": true },
    "entrance": { "type": "object", "description": "Scene spawn and room pair.", "properties": { "spawn": { "$ref": "common.schema.json#/$defs/integer", "description": "Spawn index." }, "room": { "$ref": "common.schema.json#/$defs/integer", "description": "Room number." } }, "additionalProperties": true },
    "spawn": { "type": "object", "description": "Player spawn data.", "properties": { "id": { "$ref": "common.schema.json#/$defs/integer", "description": "Spawn id." }, "pos": { "$ref": "common.schema.json#/$defs/vector", "description": "World position." }, "rot": { "$ref": "common.schema.json#/$defs/integerVector", "description": "Binary-angle rotation." }, "params": { "$ref": "common.schema.json#/$defs/integer", "description": "Packed player params." } }, "additionalProperties": true },
    "exit": { "description": "Registered entrance name or stable numeric entrance id.", "anyOf": [{ "type": "string" }, { "type": "integer", "minimum": 0 }] },
    "transitionActor": { "type": "object", "description": "Actor between two rooms.", "properties": { "id": { "$ref": "common.schema.json#/$defs/integer", "description": "Stable actor id." }, "pos": { "$ref": "common.schema.json#/$defs/vector", "description": "World position." }, "rotY": { "$ref": "common.schema.json#/$defs/integer", "description": "Y rotation." }, "params": { "$ref": "common.schema.json#/$defs/integer", "description": "Packed actor params." }, "front": { "$ref": "#/$defs/roomSide", "description": "Front room side." }, "back": { "$ref": "#/$defs/roomSide", "description": "Back room side." } }, "additionalProperties": true },
    "roomSide": { "type": "object", "description": "Transition room and effects.", "properties": { "room": { "$ref": "common.schema.json#/$defs/integer", "description": "Room number or -1." }, "effects": { "$ref": "common.schema.json#/$defs/integer", "description": "Transition effects." } }, "additionalProperties": true },
    "materialAnim": { "type": "object", "description": "One animated-material recipe.", "properties": { "segment": { "$ref": "common.schema.json#/$defs/integer", "description": "Runtime segment number." }, "pass": { "enum": ["opa", "xlu", "both"], "description": "Display pass." }, "type": { "enum": ["texScroll", "twoTexScroll", "color", "colorLerp", "colorNonLinear", "texCycle"], "description": "Animation kind." }, "layers": { "type": "array", "description": "Texture-scroll layers.", "items": { "$ref": "#/$defs/scrollLayer" } }, "length": { "$ref": "common.schema.json#/$defs/integer", "description": "Colour-cycle length." }, "keyFrames": { "type": "array", "description": "Colour key-frame indices.", "items": { "$ref": "common.schema.json#/$defs/integer" } }, "primColors": { "type": "array", "description": "Primitive colours with LOD fraction.", "items": { "type": "array", "minItems": 5, "items": { "$ref": "common.schema.json#/$defs/integer" } } }, "envColors": { "type": "array", "description": "Environment colours.", "items": { "$ref": "common.schema.json#/$defs/rgba" } }, "textures": { "type": "array", "description": "Texture-cycle paths.", "items": { "$ref": "common.schema.json#/$defs/path" } }, "frames": { "type": "array", "description": "Texture index per frame.", "items": { "$ref": "common.schema.json#/$defs/integer" } } }, "additionalProperties": true },
    "scrollLayer": { "type": "object", "description": "One texture-scroll layer.", "properties": { "xStep": { "$ref": "common.schema.json#/$defs/integer", "description": "Horizontal step." }, "yStep": { "$ref": "common.schema.json#/$defs/integer", "description": "Vertical step." }, "width": { "$ref": "common.schema.json#/$defs/integer", "description": "Tile width." }, "height": { "$ref": "common.schema.json#/$defs/integer", "description": "Tile height." }, "xSpeed": { "$ref": "common.schema.json#/$defs/number", "description": "Fractional horizontal speed." }, "ySpeed": { "$ref": "common.schema.json#/$defs/number", "description": "Fractional vertical speed." } }, "additionalProperties": true }
  }
}
