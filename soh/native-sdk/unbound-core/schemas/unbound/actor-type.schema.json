{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unbound/actor-type.schema.json",
  "title": "Unbound 2 actor type",
  "description": "One layer for unbound/actors/<name>.json; null removes a type and fields may be partial patches.",
  "anyOf": [{ "type": "null", "description": "Remove the actor type at this path." }, { "$ref": "#/$defs/definition" }],
  "$defs": { "definition": { "type": "object", "description": "Actor type definition after merge.", "properties": { "$replace": { "type": "boolean", "description": "Replace the lower-layer actor object." }, "name": { "type": "string", "description": "Display name." }, "model": { "$ref": "#/$defs/model", "description": "Static or skeletal model." }, "collision": { "$ref": "#/$defs/collision", "description": "Optional cylinder collision." }, "talk": { "$ref": "#/$defs/talk", "description": "Optional conversation settings." }, "look": { "$ref": "#/$defs/look", "description": "Optional head-tracking settings." } }, "additionalProperties": false }, "model": { "type": "object", "description": "Exactly one model path is required after merge.", "properties": { "$replace": { "type": "boolean", "description": "Replace the lower-layer model." }, "skeleton": { "$ref": "common.schema.json#/$defs/path", "description": "Skeleton resource path." }, "animation": { "$ref": "common.schema.json#/$defs/path", "description": "Animation path required with skeleton." }, "frame": { "$ref": "common.schema.json#/$defs/number", "description": "Held animation frame." }, "speed": { "$ref": "common.schema.json#/$defs/number", "description": "Loop playback rate." }, "displayList": { "$ref": "common.schema.json#/$defs/path", "description": "Static display-list path." }, "translucent": { "$ref": "common.schema.json#/$defs/integer", "description": "Translucent-pass flag." }, "scale": { "$ref": "common.schema.json#/$defs/number", "description": "Positive model scale." }, "yOffset": { "$ref": "common.schema.json#/$defs/number", "description": "Model-space vertical offset." }, "segments": { "type": "object", "description": "Texture paths by segments 8 through 12.", "additionalProperties": { "$ref": "common.schema.json#/$defs/path" } }, "hideLimbs": { "type": "array", "description": "Limb indices whose meshes are hidden.", "items": { "$ref": "common.schema.json#/$defs/integer" } }, "shadow": { "$ref": "common.schema.json#/$defs/number", "description": "Round shadow size." }, "cullRadius": { "$ref": "common.schema.json#/$defs/number", "description": "World culling radius." }, "drawDistance": { "$ref": "common.schema.json#/$defs/number", "description": "World draw distance." } }, "additionalProperties": false }, "collision": { "type": "object", "description": "Cylinder collision dimensions.", "properties": { "$replace": { "type": "boolean", "description": "Replace the lower-layer collision." }, "radius": { "$ref": "common.schema.json#/$defs/integer", "description": "Cylinder radius." }, "height": { "$ref": "common.schema.json#/$defs/integer", "description": "Cylinder height." }, "yShift": { "$ref": "common.schema.json#/$defs/integer", "description": "Cylinder Y shift." } }, "additionalProperties": false }, "talk": { "type": "object", "description": "Conversation settings.", "properties": { "$replace": { "type": "boolean", "description": "Replace the lower-layer talk settings." }, "message": { "$ref": "common.schema.json#/$defs/integer", "description": "Default message id." }, "range": { "$ref": "common.schema.json#/$defs/number", "description": "Talk distance." } }, "additionalProperties": false }, "look": { "type": "object", "description": "Head-tracking settings for skeletal models.", "properties": { "$replace": { "type": "boolean", "description": "Replace the lower-layer look settings." }, "limb": { "$ref": "common.schema.json#/$defs/integer", "description": "Head limb index." }, "pivot": { "$ref": "common.schema.json#/$defs/number", "description": "Head pivot." }, "range": { "$ref": "common.schema.json#/$defs/number", "description": "Look distance." }, "turnAxis": { "$ref": "common.schema.json#/$defs/vector", "description": "Head turn axis." }, "nodAxis": { "$ref": "common.schema.json#/$defs/vector", "description": "Head nod axis." } }, "additionalProperties": false } }
}
