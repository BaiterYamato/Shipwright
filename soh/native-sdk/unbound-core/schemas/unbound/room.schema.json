{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unbound/room.schema.json",
  "title": "Unbound 2 room document",
  "description": "A layer for scenes/<scene>/rooms/<n>.json; fields can be partial patches.",
  "type": "object",
  "properties": { "$schema": { "const": "unbound/room/1", "description": "Optional layer schema marker; one merged layer must provide it." }, "$replace": { "type": "boolean", "description": "Replace the lower-layer root object." }, "setups": { "$ref": "common.schema.json#/$defs/positionalList", "description": "Room setups by numeric index.", "additionalProperties": { "$ref": "#/$defs/setup" } } },
  "additionalProperties": true,
  "$defs": {
    "setup": { "type": "object", "description": "Room commands emitted for one setup.", "properties": { "behavior": { "$ref": "#/$defs/behavior", "description": "Gameplay flags." }, "echo": { "$ref": "common.schema.json#/$defs/integer", "description": "Room echo id." }, "time": { "$ref": "#/$defs/time", "description": "Room time settings." }, "skyboxModifier": { "$ref": "#/$defs/skyboxModifier", "description": "Skybox toggles." }, "wind": { "$ref": "#/$defs/wind", "description": "Wind vector and speed." }, "objects": { "$ref": "common.schema.json#/$defs/positionalList", "description": "Object ids by slot.", "additionalProperties": { "$ref": "common.schema.json#/$defs/integer" } }, "lights": { "$ref": "common.schema.json#/$defs/positionalList", "description": "Room light entries.", "additionalProperties": { "$ref": "#/$defs/light" } }, "actors": { "$ref": "#/$defs/actors", "description": "Actor entries keyed for layer merge." }, "mesh": { "$ref": "#/$defs/mesh", "description": "Room mesh declaration." } }, "additionalProperties": true },
    "behavior": { "type": "object", "description": "Gameplay flag fields.", "properties": { "gameplayFlags": { "$ref": "common.schema.json#/$defs/integer", "description": "Primary flags." }, "gameplayFlags2": { "$ref": "common.schema.json#/$defs/integer", "description": "Secondary flags." } }, "additionalProperties": true },
    "time": { "type": "object", "description": "Hour, minute, and increment.", "properties": { "hour": { "$ref": "common.schema.json#/$defs/integer", "description": "Hour or 255." }, "minute": { "$ref": "common.schema.json#/$defs/integer", "description": "Minute or 255." }, "increment": { "$ref": "common.schema.json#/$defs/integer", "description": "Clock increment or 255." } }, "additionalProperties": true },
    "skyboxModifier": { "type": "object", "description": "Skybox visibility flags.", "properties": { "skyboxDisabled": { "$ref": "common.schema.json#/$defs/integer", "description": "Disable skybox flag." }, "sunMoonDisabled": { "$ref": "common.schema.json#/$defs/integer", "description": "Disable sun/moon flag." } }, "additionalProperties": true },
    "wind": { "type": "object", "description": "Wind components.", "properties": { "west": { "$ref": "common.schema.json#/$defs/integer", "description": "West component." }, "vertical": { "$ref": "common.schema.json#/$defs/integer", "description": "Vertical component." }, "south": { "$ref": "common.schema.json#/$defs/integer", "description": "South component." }, "speed": { "$ref": "common.schema.json#/$defs/integer", "description": "Wind speed." } }, "additionalProperties": true },
    "light": { "type": "object", "description": "Directional or point room light.", "properties": { "type": { "$ref": "common.schema.json#/$defs/integer", "description": "0/2 point or 1 directional." }, "dir": { "$ref": "common.schema.json#/$defs/integerVector", "description": "Directional vector." }, "pos": { "$ref": "common.schema.json#/$defs/vector", "description": "Point position." }, "color": { "$ref": "common.schema.json#/$defs/rgb", "description": "Light RGB." }, "glow": { "$ref": "common.schema.json#/$defs/integer", "description": "Point glow." }, "radius": { "$ref": "common.schema.json#/$defs/integer", "description": "Point radius." } }, "additionalProperties": true },
    "actors": { "type": "object", "description": "Keyed actor list and merge directives.", "properties": { "$order": { "type": "array", "description": "Preferred spawn order.", "items": { "type": "string" } }, "$replace": { "type": "boolean", "description": "Replace lower-layer actor list." } }, "additionalProperties": { "anyOf": [{ "type": "null", "description": "Delete this actor entry." }, { "$ref": "#/$defs/actor" }] } },
    "actor": { "type": "object", "description": "Room actor placement.", "properties": { "id": { "anyOf": [{ "$ref": "common.schema.json#/$defs/integer" }, { "type": "string" }], "description": "Stable numeric id or registered actor name." }, "pos": { "$ref": "common.schema.json#/$defs/vector", "description": "World position." }, "rot": { "$ref": "common.schema.json#/$defs/integerVector", "description": "Binary-angle rotation." }, "params": { "$ref": "common.schema.json#/$defs/integer", "description": "Packed actor params; an object is reserved and skipped." } }, "additionalProperties": true },
    "mesh": { "type": "object", "description": "Mesh format selected by type.", "properties": { "type": { "$ref": "common.schema.json#/$defs/integer", "description": "Mesh type 0, 1, or 2." }, "format": { "$ref": "common.schema.json#/$defs/integer", "description": "Type-1 mesh format." }, "opa": { "$ref": "common.schema.json#/$defs/nullablePath", "description": "Opaque display list." }, "xlu": { "$ref": "common.schema.json#/$defs/nullablePath", "description": "Translucent display list." }, "entries": { "$ref": "common.schema.json#/$defs/positionalList", "description": "Type-0 or type-2 mesh entries." }, "image": { "$ref": "#/$defs/image", "description": "Type-1 format-1 image." }, "images": { "$ref": "common.schema.json#/$defs/positionalList", "description": "Type-1 format-2 images." } }, "additionalProperties": true },
    "image": { "type": "object", "description": "Background image metadata.", "properties": { "source": { "$ref": "common.schema.json#/$defs/path", "description": "Image path." }, "tlut": { "$ref": "common.schema.json#/$defs/integer", "description": "TLUT id." }, "width": { "$ref": "common.schema.json#/$defs/integer", "description": "Image width." }, "height": { "$ref": "common.schema.json#/$defs/integer", "description": "Image height." }, "fmt": { "$ref": "common.schema.json#/$defs/integer", "description": "Image format." }, "siz": { "$ref": "common.schema.json#/$defs/integer", "description": "Image size." }, "mode0": { "$ref": "common.schema.json#/$defs/integer", "description": "Render mode." }, "tlutCount": { "$ref": "common.schema.json#/$defs/integer", "description": "TLUT count." }, "unk0C": { "$ref": "common.schema.json#/$defs/integer", "description": "Vanilla unknown value." }, "id": { "$ref": "common.schema.json#/$defs/integer", "description": "Format-2 image id." }, "unk00": { "$ref": "common.schema.json#/$defs/integer", "description": "Format-2 unknown value." } }, "additionalProperties": true }
  }
}
