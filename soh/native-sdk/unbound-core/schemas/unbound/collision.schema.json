{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unbound/collision.schema.json",
  "title": "Unbound 2 collision document",
  "description": "A layer for scenes/<scene>/collision.json; collision.bin is a separate binary resource.",
  "type": "object",
  "properties": { "$schema": { "const": "unbound/collision/3", "description": "Optional layer schema marker; the merged document requires version 3." }, "bounds": { "type": "object", "description": "Collision world bounds.", "properties": { "min": { "$ref": "common.schema.json#/$defs/vector", "description": "Minimum bound." }, "max": { "$ref": "common.schema.json#/$defs/vector", "description": "Maximum bound." } }, "additionalProperties": true }, "bulk": { "type": "object", "description": "Binary collision payload metadata.", "properties": { "file": { "$ref": "common.schema.json#/$defs/path", "description": "collision.bin path." }, "vertices": { "$ref": "common.schema.json#/$defs/integer", "description": "Vertex count." }, "polys": { "$ref": "common.schema.json#/$defs/integer", "description": "Polygon count." } }, "additionalProperties": true }, "surfaceTypes": { "$ref": "common.schema.json#/$defs/positionalList", "description": "Surface type entries.", "additionalProperties": { "$ref": "#/$defs/surface" } }, "cameras": { "$ref": "common.schema.json#/$defs/positionalList", "description": "Camera metadata entries.", "additionalProperties": { "$ref": "#/$defs/camera" } }, "cameraPositions": { "$ref": "common.schema.json#/$defs/positionalList", "description": "Camera position vectors.", "additionalProperties": { "$ref": "common.schema.json#/$defs/integerVector" } }, "waterBoxes": { "$ref": "common.schema.json#/$defs/positionalList", "description": "Water box entries.", "additionalProperties": { "$ref": "#/$defs/water" } } },
  "additionalProperties": true,
  "$defs": { "surface": { "type": "object", "description": "Unpacked collision surface type.", "properties": { "camera": { "$ref": "common.schema.json#/$defs/integer", "description": "Camera index." }, "material": { "$ref": "common.schema.json#/$defs/integer", "description": "Material id." }, "exit": { "$ref": "common.schema.json#/$defs/integer", "description": "One-based scene exit index." }, "floorEffect": { "$ref": "common.schema.json#/$defs/integer", "description": "Floor effect." }, "floorType": { "$ref": "common.schema.json#/$defs/integer", "description": "Floor type." }, "lightSetting": { "$ref": "common.schema.json#/$defs/integer", "description": "Lighting index." }, "wallFlags": { "$ref": "common.schema.json#/$defs/integer", "description": "Wall flags." }, "echo": { "$ref": "common.schema.json#/$defs/integer", "description": "Echo id." }, "wallType": { "$ref": "common.schema.json#/$defs/integer", "description": "Wall type." }, "canHookshot": { "$ref": "common.schema.json#/$defs/integer", "description": "Hookshot flag." }, "floorProperty": { "$ref": "common.schema.json#/$defs/integer", "description": "Floor property." }, "conveyorSpeed": { "$ref": "common.schema.json#/$defs/integer", "description": "Conveyor speed." }, "isSoft": { "$ref": "common.schema.json#/$defs/integer", "description": "Soft-surface flag." }, "conveyorDirection": { "$ref": "common.schema.json#/$defs/integer", "description": "Conveyor direction." }, "isHorseBlocked": { "$ref": "common.schema.json#/$defs/integer", "description": "Horse-block flag." }, "isWallDamage": { "$ref": "common.schema.json#/$defs/integer", "description": "Wall-damage flag." } }, "additionalProperties": true }, "camera": { "type": "object", "description": "Camera count and position start.", "properties": { "sType": { "$ref": "common.schema.json#/$defs/integer", "description": "Camera setting type." }, "count": { "$ref": "common.schema.json#/$defs/integer", "description": "Consecutive position count." }, "positionIndex": { "anyOf": [{ "$ref": "common.schema.json#/$defs/integer" }, { "type": "null" }], "description": "First camera position or none." } }, "additionalProperties": true }, "water": { "type": "object", "description": "Water-volume metadata.", "properties": { "xMin": { "$ref": "common.schema.json#/$defs/integer", "description": "Minimum X." }, "ySurface": { "$ref": "common.schema.json#/$defs/integer", "description": "Surface Y." }, "zMin": { "$ref": "common.schema.json#/$defs/integer", "description": "Minimum Z." }, "xLength": { "$ref": "common.schema.json#/$defs/integer", "description": "X extent." }, "zLength": { "$ref": "common.schema.json#/$defs/integer", "description": "Z extent." }, "camera": { "$ref": "common.schema.json#/$defs/integer", "description": "Camera index." }, "lightSetting": { "$ref": "common.schema.json#/$defs/integer", "description": "Lighting index." }, "room": { "$ref": "common.schema.json#/$defs/integer", "description": "Room number or -1." }, "notSwimmable": { "$ref": "common.schema.json#/$defs/integer", "description": "Non-swimmable flag." } }, "additionalProperties": true } }
}
