{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unbound/scene-registry.schema.json",
  "title": "Unbound 2 scene registry",
  "description": "Layer-merged unbound/scenes.json mapping custom scene ids to definitions.",
  "type": "object",
  "properties": { "$order": { "type": "array", "description": "Optional registry key order.", "items": { "type": "string" } } },
  "additionalProperties": { "anyOf": [{ "type": "null", "description": "Delete this scene registry entry." }, { "$ref": "#/$defs/scene" }] },
  "$defs": { "scene": { "type": "object", "description": "Custom scene definition; scene can arrive from a lower layer.", "properties": { "$replace": { "type": "boolean", "description": "Replace the lower-layer scene object." }, "name": { "type": "string", "description": "Display name." }, "scene": { "$ref": "common.schema.json#/$defs/path", "description": "Scene resource path." }, "sceneId": { "description": "Deprecated numeric id; ignored by the reader.", "type": ["number", "string", "boolean"] }, "drawConfig": { "type": "integer", "minimum": 0, "maximum": 255, "description": "Vanilla draw-config index." }, "titleCardTexture": { "type": ["string", "null"], "description": "Optional title-card texture path." }, "horse": { "description": "Epona permission or wait position.", "anyOf": [{ "type": "boolean" }, { "$ref": "#/$defs/horse" }] }, "entrances": { "type": "object", "description": "Named custom entrances.", "additionalProperties": { "$ref": "#/$defs/entrance" } } }, "additionalProperties": true }, "horse": { "type": "object", "description": "Epona wait position and angle.", "properties": { "pos": { "$ref": "common.schema.json#/$defs/vector", "description": "Wait position." }, "angle": { "type": "integer", "minimum": -32768, "maximum": 32767, "description": "Binary-angle facing." } }, "required": ["pos", "angle"], "additionalProperties": true }, "entrance": { "type": "object", "description": "One named custom entrance.", "properties": { "$replace": { "type": "boolean", "description": "Replace the lower-layer entrance." }, "index": { "description": "Deprecated index; ignored by the reader.", "type": ["number", "string", "boolean"] }, "spawn": { "type": "integer", "minimum": 0, "maximum": 127, "description": "Scene spawn index." }, "showTitleCard": { "anyOf": [{ "type": "boolean" }, { "enum": [0, 1] }], "description": "Show a title card." }, "continueBgm": { "anyOf": [{ "type": "boolean" }, { "enum": [0, 1] }], "description": "Continue current music." }, "endTransition": { "type": "integer", "minimum": 0, "maximum": 127, "description": "Exit transition id." }, "startTransition": { "type": "integer", "minimum": 0, "maximum": 127, "description": "Entry transition id." }, "layers": { "description": "Reserved value; ignored by the reader." } }, "additionalProperties": true } }
}
